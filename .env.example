# --- Beacon environment ---
# Copy this file to `.env` and fill in what you have.

# Anthropic API key. Used server-side for resume parsing, fit reasons,
# cover notes, and screening answers. If omitted, Beacon falls back to a
# heuristic (regex/keyword) parser and templated text — the app still runs,
# but quality is lower. Never expose this in client code.
ANTHROPIC_API_KEY=

# Model used for the LLM steps. Defaults to a fast, low-cost model.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Prisma / SQLite (MVP). Swap to Postgres for phase 2 accounts.
DATABASE_URL="file:./dev.db"

# --- Optional supplementary job sources (safe to leave blank) ---
# Adzuna aggregator: has salary data. Requires a free app id + key.
# Create at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Remotive and Arbeitnow are free, remote-focused, and need no key.
# They are used automatically when enabled below.
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=false
